+template<int32 ImmAmt>
+FORCEINLINE VectorRegister4Int VectorShiftLeftImmTemplate(const VectorRegister4Int& Vec)
+{
+	static_assert(ImmAmt >= 0, "Shift count must be non-negative");
+	if constexpr (ImmAmt >= 32)
+	{
+		return MakeVectorRegisterInt(0, 0, 0, 0);
+	}
+	else
+	{
+		return MakeVectorRegisterInt(
+			static_cast<int32>(static_cast<uint32>(Vec.V[0]) << ImmAmt),
+			static_cast<int32>(static_cast<uint32>(Vec.V[1]) << ImmAmt),
+			static_cast<int32>(static_cast<uint32>(Vec.V[2]) << ImmAmt),
+			static_cast<int32>(static_cast<uint32>(Vec.V[3]) << ImmAmt));
