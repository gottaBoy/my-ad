+template<int32 ImmAmt>
+FORCEINLINE VectorRegister4Int VectorShiftRightImmArithmeticTemplate(const VectorRegister4Int& Vec)
+{
+	static_assert(ImmAmt >= 0, "Shift count must be non-negative");
+	// Packed arithmetic shifts saturate to the sign bit at counts of 32 or more.
+	constexpr int32 Shift = ImmAmt < 32 ? ImmAmt : 31;
+	return MakeVectorRegisterInt(Vec.V[0] >> Shift, Vec.V[1] >> Shift, Vec.V[2] >> Shift, Vec.V[3] >> Shift);
+}
