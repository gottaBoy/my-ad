+	bool BoundedArray(uint32 Count, const void* Data, uint32 Limit, bool& bComplete)
+	{
+		if (Count <= Limit && (Count == 0 || Data))
+		{
+			return true;
+		}
+		bComplete = false;
+		return false;
+	}
+
+	void AppendChain(FString& Output, const FString& Prefix, const void* Next, bool& bComplete)
+	{
+		const VkBaseInStructure* Node = static_cast<const VkBaseInStructure*>(Next);
+		for (uint32 Index = 0; Node && Index < 8; ++Index)
+		{
+			const FString Key = FString::Printf(TEXT("%s_ext%u"), *Prefix, Index);
+			Output += FString::Printf(TEXT("%s_type=%u\n"), *Key, Node->sType);
+			switch (Node->sType)
+			{
+			case VK_STRUCTURE_TYPE_ATTACHMENT_DESCRIPTION_STENCIL_LAYOUT:
+			{
+				const auto& Stencil = *reinterpret_cast<const VkAttachmentDescriptionStencilLayout*>(Node);
+				Output += FString::Printf(TEXT("%s_stencil=%u,%u\n"), *Key,
+					Stencil.stencilInitialLayout, Stencil.stencilFinalLayout);
+				break;
+			}
+			case VK_STRUCTURE_TYPE_ATTACHMENT_REFERENCE_STENCIL_LAYOUT:
+			{
+				const auto& Stencil = *reinterpret_cast<const VkAttachmentReferenceStencilLayout*>(Node);
+				Output += FString::Printf(TEXT("%s_stencil=%u\n"), *Key, Stencil.stencilLayout);
+				break;
+			}
+			case VK_STRUCTURE_TYPE_SUBPASS_DESCRIPTION_DEPTH_STENCIL_RESOLVE:
+			{
+				const auto& Resolve = *reinterpret_cast<const VkSubpassDescriptionDepthStencilResolve*>(Node);
+				Output += FString::Printf(TEXT("%s_modes=%u,%u\n"), *Key,
+					Resolve.depthResolveMode, Resolve.stencilResolveMode);
+				if (Resolve.pDepthStencilResolveAttachment)
+				{
+					const auto& Ref = *Resolve.pDepthStencilResolveAttachment;
+					Output += FString::Printf(TEXT("%s_ref=%u,%u,%u pnext=%u\n"), *Key,
+						Ref.attachment, Ref.layout, Ref.aspectMask, Ref.pNext ? 1u : 0u);
+					bComplete &= Ref.pNext == nullptr;
+				}
+				break;
+			}
+			case VK_STRUCTURE_TYPE_FRAGMENT_SHADING_RATE_ATTACHMENT_INFO_KHR:
+			{
+				const auto& Rate = *reinterpret_cast<const VkFragmentShadingRateAttachmentInfoKHR*>(Node);
+				Output += FString::Printf(TEXT("%s_texel=%u,%u\n"), *Key,
+					Rate.shadingRateAttachmentTexelSize.width,
+					Rate.shadingRateAttachmentTexelSize.height);
+				if (Rate.pFragmentShadingRateAttachment)
+				{
+					const auto& Ref = *Rate.pFragmentShadingRateAttachment;
+					Output += FString::Printf(TEXT("%s_ref=%u,%u,%u pnext=%u\n"), *Key,
+						Ref.attachment, Ref.layout, Ref.aspectMask, Ref.pNext ? 1u : 0u);
+					bComplete &= Ref.pNext == nullptr;
+				}
+				break;
+			}
+			case VK_STRUCTURE_TYPE_RENDER_PASS_FRAGMENT_DENSITY_MAP_CREATE_INFO_EXT:
+			{
+				const auto& Density = *reinterpret_cast<const VkRenderPassFragmentDensityMapCreateInfoEXT*>(Node);
+				Output += FString::Printf(TEXT("%s_ref=%u,%u\n"), *Key,
+					Density.fragmentDensityMapAttachment.attachment,
+					Density.fragmentDensityMapAttachment.layout);
+				break;
+			}
+			case VK_STRUCTURE_TYPE_RENDER_PASS_MULTIVIEW_CREATE_INFO:
+			{
+				const auto& Multiview = *reinterpret_cast<const VkRenderPassMultiviewCreateInfo*>(Node);
+				Output += FString::Printf(TEXT("%s_counts=%u,%u,%u\n"), *Key,
+					Multiview.subpassCount, Multiview.dependencyCount,
+					Multiview.correlationMaskCount);
+				if (BoundedArray(Multiview.subpassCount, Multiview.pViewMasks, 8, bComplete))
+				{
+					for (uint32 Subpass = 0; Subpass < Multiview.subpassCount; ++Subpass)
+					{
+						Output += FString::Printf(TEXT("%s_view%u=%u\n"),
+							*Key, Subpass, Multiview.pViewMasks[Subpass]);
+					}
+				}
+				if (BoundedArray(Multiview.dependencyCount, Multiview.pViewOffsets, 64, bComplete))
+				{
+					for (uint32 Dependency = 0; Dependency < Multiview.dependencyCount; ++Dependency)
+					{
+						Output += FString::Printf(TEXT("%s_offset%u=%d\n"),
+							*Key, Dependency, Multiview.pViewOffsets[Dependency]);
+					}
+				}
+				if (BoundedArray(Multiview.correlationMaskCount, Multiview.pCorrelationMasks, 8, bComplete))
+				{
+					for (uint32 Mask = 0; Mask < Multiview.correlationMaskCount; ++Mask)
+					{
+						Output += FString::Printf(TEXT("%s_mask%u=%u\n"),
+							*Key, Mask, Multiview.pCorrelationMasks[Mask]);
+					}
+				}
+				break;
+			}
+			default:
+				bComplete = false;
+				return;
+			}
+			Node = Node->pNext;
+		}
+		if (Node)
+		{
+			bComplete = false;
+			Output += FString::Printf(TEXT("%s_extension_limit=1\n"), *Prefix);
+		}
+	}
