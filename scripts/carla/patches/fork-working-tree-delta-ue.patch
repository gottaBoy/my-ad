+
+	template <typename T>
+	void AppendSubpass(FString& Output, uint32 Index, const T& Subpass, bool& bComplete)
+	{
+		const FString Prefix = FString::Printf(TEXT("subpass%u"), Index);
+		Output += FString::Printf(TEXT("%s_flags=%u\n%s_bind_point=%u\n"
+			"%s_inputs=%u\n%s_colors=%u\n%s_resolves=%u\n%s_depth=%u\n%s_preserves=%u\n"),
+			*Prefix, Subpass.flags, *Prefix, Subpass.pipelineBindPoint,
+			*Prefix, Subpass.inputAttachmentCount, *Prefix, Subpass.colorAttachmentCount,
+			*Prefix, Subpass.pResolveAttachments ? 1u : 0u,
+			*Prefix, Subpass.pDepthStencilAttachment ? 1u : 0u,
+			*Prefix, Subpass.preserveAttachmentCount);
+		AppendSubpassExtras(Output, Prefix, Subpass, bComplete);
+		if (BoundedArray(Subpass.inputAttachmentCount, Subpass.pInputAttachments, 64, bComplete))
+		{
+			for (uint32 Ref = 0; Ref < Subpass.inputAttachmentCount; ++Ref)
+			{
+				AppendReference(Output, FString::Printf(TEXT("%s_input%u"), *Prefix, Ref),
+					Subpass.pInputAttachments[Ref], bComplete);
+			}
+		}
+		if (BoundedArray(Subpass.colorAttachmentCount, Subpass.pColorAttachments, 64, bComplete))
+		{
+			for (uint32 Ref = 0; Ref < Subpass.colorAttachmentCount; ++Ref)
+			{
+				AppendReference(Output, FString::Printf(TEXT("%s_color%u"), *Prefix, Ref),
+					Subpass.pColorAttachments[Ref], bComplete);
+			}
+		}
+		if (Subpass.pResolveAttachments &&
+			BoundedArray(Subpass.colorAttachmentCount, Subpass.pResolveAttachments, 64, bComplete))
+		{
+			for (uint32 Ref = 0; Ref < Subpass.colorAttachmentCount; ++Ref)
+			{
+				AppendReference(Output, FString::Printf(TEXT("%s_resolve%u"), *Prefix, Ref),
+					Subpass.pResolveAttachments[Ref], bComplete);
+			}
+		}
+		if (Subpass.pDepthStencilAttachment)
+		{
+			AppendReference(Output, Prefix + TEXT("_depth_ref"),
+				*Subpass.pDepthStencilAttachment, bComplete);
+		}
+		if (BoundedArray(Subpass.preserveAttachmentCount, Subpass.pPreserveAttachments, 64, bComplete))
+		{
+			for (uint32 Ref = 0; Ref < Subpass.preserveAttachmentCount; ++Ref)
+			{
+				Output += FString::Printf(TEXT("%s_preserve%u=%u\n"),
+					*Prefix, Ref, Subpass.pPreserveAttachments[Ref]);
+			}
+		}
+	}
