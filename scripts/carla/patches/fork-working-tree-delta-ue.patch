+	template <typename T>
+	void RecordImpl(VkRenderPass Handle, const T& Info, const TCHAR* API)
+	{
+		FString Directory;
+		if (!Handle || !FParse::Value(FCommandLine::Get(),
+				TEXT("CarlaVulkanPipelineHistory="), Directory) || Directory.IsEmpty())
+		{
+			return;
+		}
+		bool bComplete = true;
+		FString Output = FString::Printf(TEXT("schema=1\napi=%s\nhandle=0x%llx\n"
+			"flags=%u\nattachments=%u\nsubpasses=%u\ndependencies=%u\n"),
+			API, reinterpret_cast<uint64>(Handle), Info.flags, Info.attachmentCount,
+			Info.subpassCount, Info.dependencyCount);
+		AppendChain(Output, TEXT("root"), Info.pNext, bComplete);
+		AppendCorrelation(Output, Info, bComplete);
+		if (BoundedArray(Info.attachmentCount, Info.pAttachments, 64, bComplete))
+		{
+			for (uint32 Index = 0; Index < Info.attachmentCount; ++Index)
+			{
+				AppendAttachment(Output, FString::Printf(TEXT("attachment%u"), Index),
+					Info.pAttachments[Index], bComplete);
+			}
+		}
+		if (BoundedArray(Info.subpassCount, Info.pSubpasses, 8, bComplete))
+		{
+			for (uint32 Index = 0; Index < Info.subpassCount; ++Index)
+			{
+				AppendSubpass(Output, Index, Info.pSubpasses[Index], bComplete);
+			}
+		}
+		if (BoundedArray(Info.dependencyCount, Info.pDependencies, 64, bComplete))
+		{
+			for (uint32 Index = 0; Index < Info.dependencyCount; ++Index)
+			{
+				AppendDependency(Output, Index, Info.pDependencies[Index], bComplete);
+			}
+		}
+		Output += FString::Printf(TEXT("capture_complete=%u\nend=1\n"), bComplete ? 1u : 0u);
+		const FString Name = FString::Printf(TEXT("renderpasses/renderpass-%llu-0x%llx.txt"),
+			FPlatformTime::Cycles64(), reinterpret_cast<uint64>(Handle));
+		IFileManager::Get().MakeDirectory(*(Directory / TEXT("renderpasses")), true);
+		if (FFileHelper::SaveStringToFile(Output, *(Directory / Name)))
+		{
+			FScopeLock Scope(&Lock);
+			Files.FindOrAdd(reinterpret_cast<uint64>(Handle)) = Name;
+		}
+		else
+		{
+			UE_LOG(LogVulkanRHI, Warning, TEXT("CARLA diagnostic: render-pass create-info write failed"));
+		}
+	}
