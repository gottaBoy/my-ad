+					State += FString::Printf(TEXT("blend_attachment%u=%u,%u,%u,%u,%u,%u,%u,%u\n"),
+						Index, Attachment.blendEnable, Attachment.srcColorBlendFactor,
+						Attachment.dstColorBlendFactor, Attachment.colorBlendOp,
+						Attachment.srcAlphaBlendFactor, Attachment.dstAlphaBlendFactor,
+						Attachment.alphaBlendOp, Attachment.colorWriteMask);
+				}
+			}
+			else { State += TEXT("blend_attachments_unavailable=1\n"); }
+		}
+		if (Info.pDynamicState)
+		{
+			const auto& Dynamic = *Info.pDynamicState;
+			State += FString::Printf(TEXT("dynamic flags=%u pnext=%u states=%u\n"),
+				Dynamic.flags, Dynamic.pNext ? 1u : 0u, Dynamic.dynamicStateCount);
+			if (CaptureArray(Dynamic.dynamicStateCount, Dynamic.pDynamicStates))
+			{
+				for (uint32 Index = 0; Index < Dynamic.dynamicStateCount; ++Index)
+				{
+					State += FString::Printf(TEXT("dynamic_state%u=%u\n"), Index, Dynamic.pDynamicStates[Index]);
+				}
+			}
+			else { State += TEXT("dynamic_states_unavailable=1\n"); }
+		}
+		return State;
+	}
+
+	VkResult CreateGraphicsPipeline(
+		VkDevice Device,
+		VkPipelineCache Cache,
+		const VkGraphicsPipelineCreateInfo& Info,
+		VkPipeline* Pipeline)
+	{
+		if (!FParse::Param(FCommandLine::Get(), TEXT("CarlaVulkanSerializeGraphicsPipelineCreation"))
+			&& !SerializeMixedPipelines()
+			&& !CarlaDriverSerialization::Enabled())
+		{
+			return VulkanRHI::vkCreateGraphicsPipelines(
+				Device, Cache, 1, &Info, VULKAN_CPU_ALLOCATOR, Pipeline);
+		}
+		static volatile int32 bSerializationLogged = 0;
+		if (FPlatformAtomics::InterlockedCompareExchange(&bSerializationLogged, 1, 0) == 0)
+		{
+			UE_LOG(LogVulkanRHI, Warning,
+				TEXT("CARLA diagnostic: serializing vkCreateGraphicsPipelines driver calls"));
+		}
+		FScopeLock Scope(&GraphicsCreateLock);
+		const VkPipelineCache DriverCache = SubmittedCache(Cache);
+		const VkAllocationCallbacks* DriverAllocator = VULKAN_CPU_ALLOCATOR;
+		FString AttemptPrefix;
+		if (Enabled())
+		{
+			IFileManager::Get().MakeDirectory(*Directory(), true);
+			AttemptPrefix = Directory() / FString::Printf(
+				TEXT("driver-graphics-%llu-%u"),
+				FPlatformTime::Cycles64(), FPlatformTLS::GetCurrentThreadId());
+			FString Marker = FString::Printf(
+				TEXT("schema=1\nphase=enter\nthread=%u\nlayout=0x%llx\nrender_pass=0x%llx\ncache=0x%llx\nsubmitted_cache=0x%llx\nstages=%u\n"),
+				FPlatformTLS::GetCurrentThreadId(), reinterpret_cast<uint64>(Info.layout),
+				reinterpret_cast<uint64>(Info.renderPass), reinterpret_cast<uint64>(Cache),
+				reinterpret_cast<uint64>(DriverCache), Info.stageCount);
+			{
+				FScopeLock HistoryScope(&Lock);
+				for (uint32 Index = 0; Info.pStages && Index < Info.stageCount
+					&& Index < ShaderStage::NumGraphicsStages; ++Index)
+				{
+					const uint64 Module = reinterpret_cast<uint64>(Info.pStages[Index].module);
+					const FString* Hash = ModuleHashes.Find(Module);
+					const FString* File = ModuleFiles.Find(Module);
+					Marker += FString::Printf(TEXT("stage%u=%u,0x%llx,%s hash=%s file=%s\n"),
+						Index, Info.pStages[Index].stage, Module,
+						ANSI_TO_TCHAR(Info.pStages[Index].pName),
+						Hash ? **Hash : TEXT("unknown"),
+						File ? **File : TEXT("unavailable"));
+				}
+				const FString* RenderPass = RenderPassSummaries.Find(reinterpret_cast<uint64>(Info.renderPass));
+				const FString* Layout = LayoutSummaries.Find(reinterpret_cast<uint64>(Info.layout));
+				Marker += FString::Printf(TEXT("render_pass_state=%s\nlayout_state=%s\n"),
+					RenderPass ? **RenderPass : TEXT("unavailable"),
+					Layout ? **Layout : TEXT("unavailable"));
+			}
+			Marker += FString::Printf(TEXT("render_pass_file=%s\n"),
+				*CarlaRenderPassSnapshot::FileFor(Info.renderPass));
+			Marker += AllocatorSummary(DriverAllocator) + TEXT("\n");
+			Marker += GraphicsDriverState(Info);
+			if (FParse::Param(FCommandLine::Get(), TEXT("CarlaVulkanGraphicsCacheSnapshot")))
+			{
+				size_t CacheSize = 0;
+				VkResult CacheResult = VK_SUCCESS;
+				if (!Cache)
+				{
+					Marker += TEXT("cache_data=null\ncache_bytes=0\n");
+				}
+				else
+				{
+					CacheResult = CarlaCacheLifecycle::GetData(Device, Cache, &CacheSize, nullptr);
+				}
+				if (Cache && CacheResult == VK_SUCCESS && CacheSize > 0
+					&& CacheSize <= 8u * 1024u * 1024u
+					&& CapturedGraphicsCacheBytes + CacheSize <= 128u * 1024u * 1024u)
+				{
+					TArray<uint8> CacheData;
+					CacheData.SetNumUninitialized(static_cast<int32>(CacheSize));
+					CacheResult = CarlaCacheLifecycle::GetData(
+						Device, Cache, &CacheSize, CacheData.GetData());
+					if (CacheResult == VK_SUCCESS && CacheSize <= static_cast<size_t>(CacheData.Num())
+						&& FFileHelper::SaveArrayToFile(
+							MakeArrayView(CacheData.GetData(), static_cast<int32>(CacheSize)),
+							*(AttemptPrefix + TEXT(".cache.bin"))))
+					{
+						CapturedGraphicsCacheBytes += CacheSize;
+						Marker += FString::Printf(TEXT("cache_data=%s.cache.bin\ncache_bytes=%llu\n"),
+							*AttemptPrefix, static_cast<uint64>(CacheSize));
+					}
+				}
+				Marker += FString::Printf(TEXT("cache_query_result=%d\ncache_reported_bytes=%llu\n"),
+					static_cast<int32>(CacheResult), static_cast<uint64>(CacheSize));
+			}
+			Marker += TEXT("end=1\n");
+			if (!FFileHelper::SaveStringToFile(Marker, *(AttemptPrefix + TEXT(".enter.txt"))))
+			{
+				UE_LOG(LogVulkanRHI, Warning, TEXT("CARLA diagnostic: graphics driver-entry marker write failed"));
+			}
+		}
+		CarlaCacheLifecycle::Record(TEXT("graphics"), TEXT("enter"), Cache, DriverCache);
+		const VkResult Result = VulkanRHI::vkCreateGraphicsPipelines(
+			Device, DriverCache, 1, &Info, DriverAllocator, Pipeline);
+		CarlaCacheLifecycle::Record(TEXT("graphics"), TEXT("return"), Cache,
+			DriverCache, static_cast<int32>(Result));
+		if (!AttemptPrefix.IsEmpty()
+			&& !FFileHelper::SaveStringToFile(
+				FString::Printf(TEXT("schema=1\nphase=return\nresult=%d\nend=1\n"),
+					static_cast<int32>(Result)),
+				*(AttemptPrefix + TEXT(".result.txt"))))
+		{
+			UE_LOG(LogVulkanRHI, Warning, TEXT("CARLA diagnostic: graphics driver-return marker write failed"));
+		}
+		return Result;
+	}
+
+	VkResult CreateComputePipeline(
+		VkDevice Device,
+		VkPipelineCache Cache,
+		const VkComputePipelineCreateInfo& Info,
+		VkPipeline* Pipeline)
+	{
+		if (!SerializeMixedPipelines() && !CarlaDriverSerialization::Enabled())
+		{
+			return VulkanRHI::vkCreateComputePipelines(
+				Device, Cache, 1, &Info, VULKAN_CPU_ALLOCATOR, Pipeline);
+		}
+		static volatile int32 bMixedSerializationLogged = 0;
+		if (FPlatformAtomics::InterlockedCompareExchange(&bMixedSerializationLogged, 1, 0) == 0)
+		{
+			UE_LOG(LogVulkanRHI, Warning,
+				TEXT("CARLA diagnostic: serializing mixed graphics/compute pipeline driver calls"));
+		}
+		FScopeLock Scope(&GraphicsCreateLock);
+		const VkPipelineCache DriverCache = SubmittedCache(Cache);
+		const VkAllocationCallbacks* DriverAllocator = VULKAN_CPU_ALLOCATOR;
+		FString AttemptPrefix;
+		if (Enabled())
+		{
+			IFileManager::Get().MakeDirectory(*Directory(), true);
+			AttemptPrefix = Directory() / FString::Printf(
+				TEXT("driver-compute-%llu-%u-%s"),
+				FPlatformTime::Cycles64(), FPlatformTLS::GetCurrentThreadId(),
+				ANSI_TO_TCHAR(Info.stage.pName));
+			FString Marker = FString::Printf(
+				TEXT("schema=1\nphase=enter\nentry=%s\nthread=%u\nmodule=0x%llx\nlayout=0x%llx\ncache=0x%llx\nsubmitted_cache=0x%llx\n"),
+				ANSI_TO_TCHAR(Info.stage.pName), FPlatformTLS::GetCurrentThreadId(),
+				reinterpret_cast<uint64>(Info.stage.module),
+				reinterpret_cast<uint64>(Info.layout), reinterpret_cast<uint64>(Cache),
+				reinterpret_cast<uint64>(DriverCache));
+			Marker += AllocatorSummary(DriverAllocator) + TEXT("\nend=1\n");
+			if (!FFileHelper::SaveStringToFile(Marker, *(AttemptPrefix + TEXT(".enter.txt"))))
+			{
+				UE_LOG(LogVulkanRHI, Warning, TEXT("CARLA diagnostic: driver-entry marker write failed"));
+			}
+		}
+		CarlaCacheLifecycle::Record(TEXT("compute"), TEXT("enter"), Cache, DriverCache);
+		const VkResult Result = VulkanRHI::vkCreateComputePipelines(
+			Device, DriverCache, 1, &Info, DriverAllocator, Pipeline);
+		CarlaCacheLifecycle::Record(TEXT("compute"), TEXT("return"), Cache,
+			DriverCache, static_cast<int32>(Result));
+		if (!AttemptPrefix.IsEmpty()
+			&& !FFileHelper::SaveStringToFile(
+				FString::Printf(TEXT("schema=1\nphase=return\nresult=%d\nend=1\n"),
+					static_cast<int32>(Result)),
+				*(AttemptPrefix + TEXT(".result.txt"))))
+		{
+			UE_LOG(LogVulkanRHI, Warning, TEXT("CARLA diagnostic: driver-return marker write failed"));
+		}
+		return Result;
+	}
+
+	struct FStage
+	{
+		uint32 Stage = 0;
+		uint64 Module = 0;
+		ANSICHAR Entry[24] = {};
+	};
+
+	struct FEvent
+	{
+		uint64 Sequence = 0;
+		uint64 Call = 0;
+		uint64 Cache = 0;
+		uint64 Layout = 0;
+		uint64 RenderPass = 0;
+		uint32 Thread = 0;
+		uint32 Flags = 0;
+		uint32 StageCount = 0;
+		int32 Result = 0;
+		bool bGraphics = false;
+		bool bReturned = false;
+		FStage Stages[ShaderStage::NumGraphicsStages];
+		FString FixedState;
+	};
+
+	constexpr uint32 Capacity = 4096;
+	FEvent Events[Capacity];
+	uint64 NextSequence = 0;
+	TSet<FString> ClaimedTargets;
+
+	const FString& Directory()
+	{
+		static const FString Value = []()
+		{
+			FString Path;
+			FParse::Value(FCommandLine::Get(), TEXT("CarlaVulkanPipelineHistory="), Path);
+			return Path;
+		}();
+		return Value;
+	}
+
+	bool Enabled()
+	{
+		return !Directory().IsEmpty();
+	}
+
+	void RecordGraphicsShaderInputs(
+		FVulkanShader* const* Shaders,
+		const TRefCountPtr<FVulkanShaderModule>(&Modules)[ShaderStage::NumGraphicsStages])
+	{
+		if (!Enabled())
+		{
+			return;
+		}
+		FScopeLock Scope(&Lock);
+		for (uint32 Index = 0; Index < ShaderStage::NumGraphicsStages; ++Index)
+		{
+			if (!Shaders[Index] || !Modules[Index].IsValid())
+			{
+				continue;
+			}
+			const FString Hash = Shaders[Index]->GetCodeHeader().SourceHash.ToString();
+			const uint64 Module = reinterpret_cast<uint64>(Modules[Index]->GetVkShaderModule());
+			ModuleHashes.FindOrAdd(Module) = Hash;
+			const TArray<uint32>& Words = Modules[Index]->GetDiagnosticSpirv();
+			if (Words.IsEmpty() || Modules[Index]->GetDiagnosticId() == 0)
+			{
+				continue;
+			}
+			const FString DirectoryPath = Directory() / TEXT("graphics-shaders");
+			const FString File = FString::Printf(TEXT("graphics-shaders/module-%llu.spv"),
+				Modules[Index]->GetDiagnosticId());
+			const FString ShaderPath = Directory() / File;
+			if (IFileManager::Get().FileExists(*ShaderPath))
+			{
+				ModuleFiles.FindOrAdd(Module) = File;
+				continue;
+			}
+			IFileManager::Get().MakeDirectory(*DirectoryPath, true);
+			if (FFileHelper::SaveArrayToFile(
+					MakeArrayView(reinterpret_cast<const uint8*>(Words.GetData()), Words.Num() * sizeof(uint32)),
+					*ShaderPath))
+			{
+				ModuleFiles.FindOrAdd(Module) = File;
+			}
+			else
+			{
+				ModuleFiles.Remove(Module);
+				UE_LOG(LogVulkanRHI, Warning, TEXT("CARLA diagnostic: exact shader module write failed"));
+			}
+		}
+	}
+
+	void RecordGraphicsLayoutInput(const FVulkanLayout* Layout, bool bBindless)
+	{
+		if (!Enabled() || !Layout)
+		{
+			return;
+		}
+		const uint64 Handle = reinterpret_cast<uint64>(Layout->GetPipelineLayout());
+		FScopeLock Scope(&Lock);
+		const auto& Sets = Layout->GetDescriptorSetsLayout().GetLayouts();
+		FString Summary = FString::Printf(TEXT("sets=%d descriptor_hash=%u bindless=%u push_constant_ranges=%s"),
+			Sets.Num(), Layout->GetDescriptorSetLayoutHash(), bBindless ? 1u : 0u,
+			bBindless ? TEXT("unknown") : TEXT("0"));
+		if (Sets.Num() > 16)
+		{
+			Summary += TEXT(" truncated=1");
+		}
+		for (int32 Set = 0; Set < Sets.Num() && Set < 16; ++Set)
+		{
+			const auto& Bindings = Sets[Set].LayoutBindings;
+			Summary += FString::Printf(TEXT(" set%d_bindings=%d"), Set, Bindings.Num());
+			for (int32 Index = 0; Index < Bindings.Num() && Index < 64; ++Index)
+			{
+				const VkDescriptorSetLayoutBinding& Binding = Bindings[Index];
+				Summary += FString::Printf(TEXT(" set%d_binding%d=%u,%u,%u,%u,%u"),
+					Set, Index, Binding.binding, Binding.descriptorType,
+					Binding.descriptorCount, Binding.stageFlags,
+					Binding.pImmutableSamplers ? 1u : 0u);
+			}
+			if (Bindings.Num() > 64)
+			{
+				Summary += FString::Printf(TEXT(" set%d_truncated=1"), Set);
+			}
+		}
+		LayoutSummaries.FindOrAdd(Handle) = MoveTemp(Summary);
+	}
+
+	void RecordRenderPassInput(const FVulkanRenderPass* RenderPass)
+	{
+		if (!Enabled() || !RenderPass)
+		{
+			return;
+		}
+		const uint64 Handle = reinterpret_cast<uint64>(RenderPass->GetHandle());
+		FScopeLock Scope(&Lock);
+		const FVulkanRenderTargetLayout& Layout = RenderPass->GetLayout();
+		FString Summary = FString::Printf(
+			TEXT("compatible_hash=%u full_hash=%u attachments=%u colors=%u samples=%u depth_stencil=%u resolves=%u depth_resolve=%u fragment_density=%u multiview=%u subpass_hint=%u"),
+			Layout.GetRenderPassCompatibleHash(), Layout.GetRenderPassFullHash(),
+			Layout.GetNumAttachmentDescriptions(), Layout.GetNumColorAttachments(),
+			Layout.GetNumSamples(), Layout.GetHasDepthStencil() ? 1u : 0u,
+			Layout.GetHasResolveAttachments() ? 1u : 0u,
+			Layout.GetHasDepthStencilResolve() ? 1u : 0u,
+			Layout.GetHasFragmentDensityAttachment() ? 1u : 0u,
+			Layout.GetMultiViewCount(), static_cast<uint32>(Layout.GetSubpassHint()));
+		const VkAttachmentDescription* Descriptions = Layout.GetAttachmentDescriptions();
+		for (uint32 Index = 0; Index < Layout.GetNumAttachmentDescriptions(); ++Index)
+		{
+			const VkAttachmentDescription& Description = Descriptions[Index];
+			Summary += FString::Printf(
+				TEXT(" attachment%u=format%u samples=%u load=%u store=%u stencil_load=%u stencil_store=%u initial=%u final=%u"),
+				Index, Description.format, Description.samples, Description.loadOp,
+				Description.storeOp, Description.stencilLoadOp, Description.stencilStoreOp,
+				Description.initialLayout, Description.finalLayout);
+		}
+		const VkAttachmentReference* Colors = Layout.GetColorAttachmentReferences();
+		for (uint32 Index = 0; Colors && Index < Layout.GetNumColorAttachments(); ++Index)
+		{
+			Summary += FString::Printf(TEXT(" color_ref%u=%u,%u"),
+				Index, Colors[Index].attachment, Colors[Index].layout);
+		}
+		if (const VkAttachmentReference* Depth = Layout.GetDepthAttachmentReference())
+		{
+			Summary += FString::Printf(TEXT(" depth_ref=%u,%u"),
+				Depth->attachment, Depth->layout);
+		}
+		if (const VkAttachmentReference* Resolves = Layout.GetResolveAttachmentReferences())
+		{
+			for (uint32 Index = 0; Index < Layout.GetNumColorAttachments(); ++Index)
+			{
+				Summary += FString::Printf(TEXT(" resolve_ref%u=%u,%u"),
+					Index, Resolves[Index].attachment, Resolves[Index].layout);
+			}
+		}
+		RenderPassSummaries.FindOrAdd(Handle) = MoveTemp(Summary);
+	}
+
+	FString GraphicsFixedState(const VkGraphicsPipelineCreateInfo& Info)
+	{
+		return FString::Printf(
+			TEXT("replay_ready=0 root_pnext=%u subpass=%u base_pipeline_present=%u base_index=%d "
+				"stages=%u vertex=%u assembly=%u tessellation=%u viewport=%u raster=%u "
+				"multisample=%u depth_stencil=%u blend=%u dynamic=%u"),
+			Info.pNext ? 1u : 0u, Info.subpass, Info.basePipelineHandle ? 1u : 0u,
+			Info.basePipelineIndex, Info.stageCount,
+			Info.pVertexInputState ? 1u : 0u, Info.pInputAssemblyState ? 1u : 0u,
+			Info.pTessellationState ? 1u : 0u, Info.pViewportState ? 1u : 0u,
+			Info.pRasterizationState ? 1u : 0u, Info.pMultisampleState ? 1u : 0u,
+			Info.pDepthStencilState ? 1u : 0u, Info.pColorBlendState ? 1u : 0u,
+			Info.pDynamicState ? 1u : 0u);
+	}
+
+	uint64 Record(VkPipelineCache Cache, const VkGraphicsPipelineCreateInfo& Info, bool bReturned, uint64 Call, VkResult Result)
+	{
+		if (!Enabled())
+		{
+			return 0;
+		}
+		FEvent Event;
+		Event.Call = Call;
+		Event.Cache = reinterpret_cast<uint64>(Cache);
+		Event.Layout = reinterpret_cast<uint64>(Info.layout);
+		Event.RenderPass = reinterpret_cast<uint64>(Info.renderPass);
+		Event.Thread = FPlatformTLS::GetCurrentThreadId();
+		Event.Flags = Info.flags;
+		Event.StageCount = FMath::Min<uint32>(Info.stageCount, ShaderStage::NumGraphicsStages);
+		Event.bGraphics = true;
+		Event.bReturned = bReturned;
+		Event.Result = static_cast<int32>(Result);
+		for (uint32 Index = 0; Index < Event.StageCount; ++Index)
+		{
+			Event.Stages[Index].Stage = Info.pStages[Index].stage;
+			Event.Stages[Index].Module = reinterpret_cast<uint64>(Info.pStages[Index].module);
+			FCStringAnsi::Strncpy(Event.Stages[Index].Entry, Info.pStages[Index].pName, UE_ARRAY_COUNT(Event.Stages[Index].Entry));
+		}
+		if (!bReturned)
+		{
+			Event.FixedState = GraphicsFixedState(Info);
+		}
+		FScopeLock Scope(&Lock);
+		Event.Sequence = ++NextSequence;
+		if (!Event.Call)
+		{
+			Event.Call = Event.Sequence;
+		}
+		Events[(Event.Sequence - 1) % Capacity] = Event;
+		return Event.Call;
+	}
+
+	uint64 Record(VkPipelineCache Cache, const VkComputePipelineCreateInfo& Info, bool bReturned, uint64 Call, VkResult Result)
+	{
+		if (!Enabled())
+		{
+			return 0;
+		}
+		FEvent Event;
+		Event.Call = Call;
+		Event.Cache = reinterpret_cast<uint64>(Cache);
+		Event.Layout = reinterpret_cast<uint64>(Info.layout);
+		Event.Thread = FPlatformTLS::GetCurrentThreadId();
+		Event.Flags = Info.flags;
+		Event.StageCount = 1;
+		Event.bReturned = bReturned;
+		Event.Result = static_cast<int32>(Result);
+		Event.Stages[0].Stage = Info.stage.stage;
+		Event.Stages[0].Module = reinterpret_cast<uint64>(Info.stage.module);
+		FCStringAnsi::Strncpy(Event.Stages[0].Entry, Info.stage.pName, UE_ARRAY_COUNT(Event.Stages[0].Entry));
+		FScopeLock Scope(&Lock);
+		Event.Sequence = ++NextSequence;
+		if (!Event.Call)
+		{
+			Event.Call = Event.Sequence;
+		}
+		Events[(Event.Sequence - 1) % Capacity] = Event;
+		return Event.Call;
+	}
+
+	void DumpBeforeTarget(const VkComputePipelineCreateInfo& Info)
+	{
+		if (!Enabled())
+		{
+			return;
+		}
+		FString ConfiguredTargets;
+		if (!FParse::Value(FCommandLine::Get(), TEXT("CarlaVulkanPipelineHistoryTarget="),
+				ConfiguredTargets, false))
+		{
+			return;
+		}
+		TArray<FString> Targets;
+		ConfiguredTargets.ParseIntoArray(Targets, TEXT(","), true);
+		const FString Target = ANSI_TO_TCHAR(Info.stage.pName);
+		const bool bCheckpoint = ConfiguredTargets == TEXT("checkpoint");
+		if (!bCheckpoint && !Targets.Contains(Target))
+		{
+			return;
+		}
+		FString Output;
+		{
+			FScopeLock Scope(&Lock);
+			if (bCheckpoint && NextSequence < 1000)
+			{
+				return;
+			}
+			const FString ClaimKey = bCheckpoint ? TEXT("checkpoint") : Target;
+			if (ClaimedTargets.Contains(ClaimKey))
+			{
+				return;
+			}
+			ClaimedTargets.Add(ClaimKey);
+			const uint64 First = NextSequence > Capacity ? NextSequence - Capacity + 1 : 1;
+			Output = FString::Printf(TEXT("schema=1\nphase=before_compute_create\ntarget=%s\ntrigger=%s\nfirst_sequence=%llu\nlast_sequence=%llu\ndropped=%llu\n"),
+				*Target, bCheckpoint ? TEXT("checkpoint") : TEXT("selected_target"),
+				First, NextSequence, First - 1);
+			for (uint64 Sequence = First; Sequence <= NextSequence; ++Sequence)
+			{
+				const FEvent& Event = Events[(Sequence - 1) % Capacity];
+				Output += FString::Printf(TEXT("event=%llu call=%llu kind=%s phase=%s thread=%u cache=0x%llx layout=0x%llx render_pass=0x%llx flags=%u stage_count=%u result=%d"),
+					Event.Sequence, Event.Call, Event.bGraphics ? TEXT("graphics") : TEXT("compute"),
+					Event.bReturned ? TEXT("result") : TEXT("begin"), Event.Thread, Event.Cache,
+					Event.Layout, Event.RenderPass, Event.Flags, Event.StageCount, Event.Result);
+				for (uint32 Index = 0; Index < Event.StageCount; ++Index)
+				{
+					Output += FString::Printf(TEXT(" stage%u=%u,0x%llx,%s"), Index,
+						Event.Stages[Index].Stage, Event.Stages[Index].Module, ANSI_TO_TCHAR(Event.Stages[Index].Entry));
+				}
+				Output += TEXT("\n");
+				if (Event.bGraphics && !Event.bReturned)
+				{
+					Output += FString::Printf(TEXT("graphics_state call=%llu %s\n"),
+						Event.Call, *Event.FixedState);
+				}
+			}
+			for (const TPair<uint64, FString>& Pair : ModuleHashes)
+			{
+				const FString* File = ModuleFiles.Find(Pair.Key);
+				Output += FString::Printf(TEXT("module=0x%llx hash=%s file=%s\n"),
+					Pair.Key, *Pair.Value, File ? **File : TEXT("unavailable"));
+			}
+			for (const TPair<uint64, FString>& Pair : RenderPassSummaries)
+			{
