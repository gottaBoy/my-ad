+namespace CarlaCacheLifecycle
+{
+#if !UE_BUILD_SHIPPING
+	FCriticalSection EventLock;
+	uint64 NextEvent = 0;
+
+	void Record(const TCHAR* Operation, const TCHAR* Phase, VkPipelineCache Cache,
+		VkPipelineCache Other, int32 Result, uint64 Bytes)
+	{
+		static const FString Directory = []()
+		{
+			FString Value;
+			if (FParse::Param(FCommandLine::Get(), TEXT("CarlaVulkanCacheLifecycle")))
+			{
+				FParse::Value(FCommandLine::Get(), TEXT("CarlaVulkanPipelineHistory="), Value);
+			}
+			return Value;
+		}();
+		if (Directory.IsEmpty())
+		{
+			return;
+		}
+		FScopeLock Scope(&EventLock);
+		IFileManager::Get().MakeDirectory(*Directory, true);
+		const FString Line = FString::Printf(
+			TEXT("event=%llu operation=%s phase=%s thread=%u cache=0x%llx other=0x%llx result=%d bytes=%llu end=1\n"),
+			++NextEvent, Operation, Phase, FPlatformTLS::GetCurrentThreadId(),
+			reinterpret_cast<uint64>(Cache), reinterpret_cast<uint64>(Other), Result, Bytes);
+		if (!FFileHelper::SaveStringToFile(Line, *(Directory / TEXT("cache-lifecycle.txt")),
+			FFileHelper::EEncodingOptions::AutoDetect, &IFileManager::Get(),
+			EFileWrite::FILEWRITE_Append))
+		{
+			UE_LOG(LogVulkanRHI, Warning, TEXT("CARLA diagnostic: cache lifecycle event write failed"));
+		}
+	}
+#else
+	void Record(const TCHAR*, const TCHAR*, VkPipelineCache, VkPipelineCache, int32, uint64) {}
+#endif
+
+	void RecordObject(const TCHAR* Operation, const TCHAR* Phase, uint64 Handle)
+	{
+		Record(Operation, Phase, reinterpret_cast<VkPipelineCache>(Handle));
+	}
+
+	VkResult Create(VkDevice Device, const VkPipelineCacheCreateInfo* Info,
+		const VkAllocationCallbacks* Allocator, VkPipelineCache* Cache)
+	{
+		Record(TEXT("create"), TEXT("enter"), VK_NULL_HANDLE, VK_NULL_HANDLE, 0,
+			static_cast<uint64>(Info->initialDataSize));
+		const VkResult Result = VulkanRHI::vkCreatePipelineCache(Device, Info, Allocator, Cache);
+		Record(TEXT("create"), TEXT("return"), Result == VK_SUCCESS ? *Cache : VK_NULL_HANDLE,
+			VK_NULL_HANDLE, static_cast<int32>(Result), static_cast<uint64>(Info->initialDataSize));
+		return Result;
+	}
+
+	void Destroy(VkDevice Device, VkPipelineCache Cache, const VkAllocationCallbacks* Allocator)
+	{
+		Record(TEXT("destroy"), TEXT("enter"), Cache);
+		VulkanRHI::vkDestroyPipelineCache(Device, Cache, Allocator);
+		Record(TEXT("destroy"), TEXT("return"), Cache);
+	}
+
+	VkResult Merge(VkDevice Device, VkPipelineCache Cache, uint32 Count,
+		const VkPipelineCache* Sources)
+	{
+		CarlaDriverSerialization::FDriverCallScope DriverCallScope;
+		const VkPipelineCache Other = Count && Sources ? Sources[0] : VK_NULL_HANDLE;
+		Record(TEXT("merge"), TEXT("enter"), Cache, Other, 0, Count);
+		const VkResult Result = VulkanRHI::vkMergePipelineCaches(Device, Cache, Count, Sources);
+		Record(TEXT("merge"), TEXT("return"), Cache, Other, static_cast<int32>(Result), Count);
+		return Result;
+	}
+
+	VkResult GetData(VkDevice Device, VkPipelineCache Cache, size_t* Size, void* Data)
+	{
+		CarlaDriverSerialization::FDriverCallScope DriverCallScope;
+		Record(TEXT("get_data"), TEXT("enter"), Cache, VK_NULL_HANDLE, Data ? 1 : 0,
+			Size ? static_cast<uint64>(*Size) : 0);
+		const VkResult Result = VulkanRHI::vkGetPipelineCacheData(Device, Cache, Size, Data);
+		Record(TEXT("get_data"), TEXT("return"), Cache, VK_NULL_HANDLE,
+			static_cast<int32>(Result), Size ? static_cast<uint64>(*Size) : 0);
+		return Result;
+	}
+}
