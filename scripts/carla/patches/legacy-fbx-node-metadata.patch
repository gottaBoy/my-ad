diff --git a/Engine/Source/Editor/UnrealEd/Public/ImportUtils/SceneImportNodeInfo.h b/Engine/Source/Editor/UnrealEd/Public/ImportUtils/SceneImportNodeInfo.h
new file mode 100644
index 000000000..223e2c459
--- /dev/null
+++ b/Engine/Source/Editor/UnrealEd/Public/ImportUtils/SceneImportNodeInfo.h
@@ -0,0 +1,24 @@
+#pragma once
+
+#include "CoreMinimal.h"
+
+namespace UE::Import
+{
+// Evaluated in Unreal coordinates. The root transform is global; children are parent-relative.
+// This metadata stores the decomposed transform consumed by the scene factory, not a raw matrix.
+struct FSceneNodeInfo
+{
+	FString ObjectName;
+	uint64 UniqueId = 0;
+	FTransform Transform;
+	FVector RotationPivot = FVector(0.0);
+	FVector ScalePivot = FVector(0.0);
+
+	FString AttributeName;
+	uint64 AttributeUniqueId = 0;
+	FString AttributeType;
+
+	FString ParentName;
+	uint64 ParentUniqueId = 0;
+};
+}
diff --git a/Engine/Source/Editor/UnrealEd/Public/ImportUtils/SceneImportHierarchy.h b/Engine/Source/Editor/UnrealEd/Public/ImportUtils/SceneImportHierarchy.h
new file mode 100644
index 000000000..0bfb63dc6
--- /dev/null
+++ b/Engine/Source/Editor/UnrealEd/Public/ImportUtils/SceneImportHierarchy.h
@@ -0,0 +1,77 @@
+#pragma once
+
+#include "SceneImportNodeInfo.h"
+
+namespace UE::Import
+{
+struct FSceneImportHierarchyEntry
+{
+	int32 SourceIndex = INDEX_NONE;
+	int32 ParentIndex = INDEX_NONE;
+	bool bImportNode = true;
+};
+
+// Source records must be parent-first. ParentIndex addresses Output, not Source.
+// Skeleton subtrees are retained in the source but omitted from the actor hierarchy.
+inline bool BuildSceneImportHierarchy(TConstArrayView<FSceneNodeInfo> Source,
+	TArray<FSceneImportHierarchyEntry>& Output, FString& Error)
+{
+	Error.Reset();
+	if (Source.IsEmpty())
+	{
+		Error = TEXT("Missing scene root");
+		return false;
+	}
+	TArray<FSceneImportHierarchyEntry> Result;
+	TMap<uint64, int32> SourceIndices;
+	TMap<uint64, int32> OutputIndices;
+	TSet<uint64> SkeletonNodes;
+	for (int32 Index = 0; Index < Source.Num(); ++Index)
+	{
+		const FSceneNodeInfo& Node = Source[Index];
+		if (SourceIndices.Contains(Node.UniqueId) || (Index > 0 && Node.UniqueId == 0))
+		{
+			Error = TEXT("Duplicate or reserved scene node identity");
+			return false;
+		}
+		int32 ParentSourceIndex = INDEX_NONE;
+		if (Index == 0)
+		{
+			if (Node.ParentUniqueId != 0)
+			{
+				Error = TEXT("Scene root must not have a parent");
+				return false;
+			}
+		}
+		else
+		{
+			const int32* Parent = SourceIndices.Find(Node.ParentUniqueId);
+			if (!Parent || Node.ParentUniqueId == Node.UniqueId)
+			{
+				Error = TEXT("Missing, cyclic or non-parent-first scene hierarchy");
+				return false;
+			}
+			ParentSourceIndex = *Parent;
+		}
+		SourceIndices.Add(Node.UniqueId, Index);
+		if (Node.AttributeType == TEXT("eSkeleton")
+			|| (Index > 0 && SkeletonNodes.Contains(Node.ParentUniqueId)))
+		{
+			SkeletonNodes.Add(Node.UniqueId);
+			continue;
+		}
+		FSceneImportHierarchyEntry Entry;
+		Entry.SourceIndex = Index;
+		if (ParentSourceIndex != INDEX_NONE)
+		{
+			Entry.ParentIndex = OutputIndices.FindChecked(Node.ParentUniqueId);
+			Entry.bImportNode = Source[ParentSourceIndex].AttributeType != TEXT("eLODGroup")
+				|| Node.AttributeType == TEXT("eMesh");
+		}
+		OutputIndices.Add(Node.UniqueId, Result.Num());
+		Result.Add(Entry);
+	}
+	Output = MoveTemp(Result);
+	return true;
+}
+}
