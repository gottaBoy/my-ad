; FBX 7.4.0 project-owned regression fixture.
; Two instances share one triangle but use different materials.
; Geometry translation/negative scaling on MeshA must not move Child.
FBXHeaderExtension: {
    FBXHeaderVersion: 1003
    FBXVersion: 7400
    Creator: "CARLA ufbx backend test"
}
GlobalSettings: {
    Version: 1000
    Properties70: {
        P: "UpAxis", "int", "Integer", "", 1
        P: "UpAxisSign", "int", "Integer", "", 1
        P: "FrontAxis", "int", "Integer", "", 2
        P: "FrontAxisSign", "int", "Integer", "", 1
        P: "CoordAxis", "int", "Integer", "", 0
        P: "CoordAxisSign", "int", "Integer", "", 1
        P: "UnitScaleFactor", "double", "Number", "", 100
        P: "OriginalUnitScaleFactor", "double", "Number", "", 100
    }
}
Objects: {
    Model: 100, "Model::Parent", "Null" {
        Version: 232
        Properties70: {
            P: "Lcl Translation", "Lcl Translation", "", "A", 0, 2, 0
        }
    }
    Model: 101, "Model::MeshA", "Mesh" {
        Version: 232
        Properties70: {
            P: "Lcl Translation", "Lcl Translation", "", "A", 3, 0, 0
            P: "GeometricTranslation", "Vector3D", "Vector", "", 0, 0, 4
            P: "GeometricScaling", "Vector3D", "Vector", "", -2, 1, 1
        }
    }
    Model: 102, "Model::Child", "Null" {
        Version: 232
        Properties70: {
            P: "Lcl Translation", "Lcl Translation", "", "A", 0, 0, 1
        }
    }
    Model: 103, "Model::MeshB", "Mesh" {
        Version: 232
        Properties70: {
            P: "Lcl Translation", "Lcl Translation", "", "A", -3, 0, 0
        }
    }
    Geometry: 200, "Geometry::SharedTriangle", "Mesh" {
        GeometryVersion: 124
        Vertices: *9 {
            a: 0,0,0,1,0,0,0,1,0
        }
        PolygonVertexIndex: *3 {
            a: 0,1,-3
        }
        LayerElementNormal: 0 {
            Version: 101
            Name: ""
            MappingInformationType: "ByPolygonVertex"
            ReferenceInformationType: "Direct"
            Normals: *9 {
                a: 0,0,1,0,0,1,0,0,1
            }
        }
        LayerElementUV: 0 {
            Version: 101
            Name: "PrimaryUV"
            MappingInformationType: "ByPolygonVertex"
            ReferenceInformationType: "Direct"
            UV: *6 {
                a: 0,0,1,0,0,1
            }
        }
        LayerElementMaterial: 0 {
            Version: 101
            Name: ""
            MappingInformationType: "AllSame"
            ReferenceInformationType: "IndexToDirect"
            Materials: *1 {
                a: 0
            }
        }
        Layer: 0 {
            Version: 100
            LayerElement: { Type: "LayerElementNormal" TypedIndex: 0 }
            LayerElement: { Type: "LayerElementUV" TypedIndex: 0 }
            LayerElement: { Type: "LayerElementMaterial" TypedIndex: 0 }
        }
    }
    Material: 300, "Material::Red", "" {
        Version: 102
        ShadingModel: "phong"
        Properties70: {
            P: "DiffuseColor", "Color", "", "A", 1, 0, 0
        }
    }
    Material: 301, "Material::Blue", "" {
        Version: 102
        ShadingModel: "phong"
        Properties70: {
            P: "DiffuseColor", "Color", "", "A", 0, 0, 1
        }
    }
}
Connections: {
    C: "OO", 100, 0
    C: "OO", 101, 100
    C: "OO", 102, 101
    C: "OO", 103, 100
    C: "OO", 200, 101
    C: "OO", 200, 103
    C: "OO", 300, 101
    C: "OO", 301, 103
}
