# Copy to .env on each host and replace all REPLACE_* values.
# Do not commit .env or image credentials.

COMPOSE_PROJECT_NAME=my-ad
HOST_ROLE=dgx
DEPLOYMENT_MODE=validation
PREFLIGHT_SCOPE=core
REQUIRE_MAP_DATA=1
MIN_FREE_DISK_GB=100
DGX_MIN_HOST_MEMORY_GB=100
SIM_MIN_HOST_MEMORY_GB=32

# Host and ROS transport
SIM_HOST_ADDR=192.168.10.10
DGX_HOST_ADDR=192.168.10.20
ROS_DOMAIN_ID=42
ROS_DISTRO=humble
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
RMW_IMPLEMENTATION_SIM=rmw_cyclonedds_cpp
CYCLONEDDS_URI=/config/cyclone/cyclonedds.xml
ZENOH_CONFIG=/config/zenoh/zenoh.json5

# Images. Pin every production image to a verified tag and digest.
# The AWSIM image must contain the official x86_64 Linux player.
AWSIM_IMAGE=REPLACE_AWSIM_X86_IMAGE
AUTOWARE_IMAGE=REPLACE_AUTOWARE_ARM64_IMAGE
ROS_BASE_IMAGE=ros:humble-ros-base
ROS_TOOLS_IMAGE=my-ad/ros-tools:humble
UTILITY_IMAGE=bash:5.2
FOXGLOVE_IMAGE=REPLACE_FOXGLOVE_ARM64_IMAGE
GROUND_TRUTH_IMAGE=REPLACE_GROUND_TRUTH_IMAGE
SCENARIO_IMAGE=REPLACE_SCENARIO_SIMULATOR_ARM64_IMAGE
ISAAC_IMAGE=REPLACE_ISAAC_SIM_ARM64_IMAGE
TENSORRT_IMAGE=REPLACE_TENSORRT_ARM64_IMAGE
GPU_SMOKE_IMAGE=REPLACE_GPU_SMOKE_IMAGE
GPU_SMOKE_COMMAND='python3 -c "import torch; x=torch.ones((1024,1024), device=\"cuda\"); y=x@x; print(torch.cuda.get_device_name(0), float(y.sum()))"'

# Commands are intentionally explicit. Replace with the command validated on the target image.
AWSIM_COMMAND=REPLACE_AWSIM_PLAYER_COMMAND
AWSIM_HEALTHCHECK_COMMAND=REPLACE_AWSIM_HEALTHCHECK_COMMAND
AUTOWARE_COMMAND=REPLACE_AUTOWARE_LAUNCH_COMMAND
AUTOWARE_HEALTHCHECK_COMMAND=REPLACE_AUTOWARE_HEALTHCHECK_COMMAND
GROUND_TRUTH_COMMAND=REPLACE_GROUND_TRUTH_COMMAND
GROUND_TRUTH_HEALTHCHECK_COMMAND=REPLACE_GROUND_TRUTH_HEALTHCHECK_COMMAND
SCENARIO_COMMAND=REPLACE_SCENARIO_COMMAND
SCENARIO_HEALTHCHECK_COMMAND=REPLACE_SCENARIO_HEALTHCHECK_COMMAND
ISAAC_COMMAND=REPLACE_ISAAC_COMMAND
ISAAC_HEALTHCHECK_COMMAND=REPLACE_ISAAC_HEALTHCHECK_COMMAND
FOXGLOVE_COMMAND=REPLACE_FOXGLOVE_COMMAND
FOXGLOVE_HEALTHCHECK_COMMAND=REPLACE_FOXGLOVE_HEALTHCHECK_COMMAND

# NAVSIM is an offline planning evaluation/training profile on DGX Spark.
# Prefer a locally verified ARM64 image. The optional source build requires a
# verified CUDA/PyTorch base image and a fixed NAVSIM git ref.
NAVSIM_IMAGE=REPLACE_NAVSIM_ARM64_IMAGE
NAVSIM_BASE_IMAGE=REPLACE_NAVSIM_CUDA_PYTORCH_ARM64_BASE
NAVSIM_REPO_URL=https://github.com/autonomousvision/navsim.git
NAVSIM_GIT_REF=REPLACE_NAVSIM_GIT_REF
NAVSIM_COMMAND=REPLACE_NAVSIM_EVALUATION_COMMAND
NAVSIM_HEALTHCHECK_COMMAND=REPLACE_NAVSIM_HEALTHCHECK_COMMAND
NAVSIM_SOURCE_DIR=./third_party/navsim
NAVSIM_DATASET_DIR=./data/navsim/dataset
NAVSIM_MAPS_DIR=./data/navsim/dataset/maps
NAVSIM_EXP_DIR=./data/navsim/exp
NAVSIM_MODEL_DIR=./data/models/navsim
NAVSIM_REPORT_DIR=./data/reports/navsim
NAVSIM_CACHE_DIR=./data/cache/navsim
NAVSIM_WORKDIR=/workspace/navsim
NAVSIM_DEVKIT_ROOT=/workspace/navsim
NAVSIM_EXP_ROOT=/data/navsim/exp
OPENSCENE_DATA_ROOT=/data/navsim/dataset
NUPLAN_MAP_VERSION=nuplan-maps-v1.0
NUPLAN_MAPS_ROOT=/data/navsim/dataset/maps
NAVSIM_SPLIT=navhard_two_stage
NAVSIM_RUN_ID=manual
NAVSIM_NUM_WORKERS=4
NAVSIM_BATCH_SIZE=1
NAVSIM_SEED=0
NAVSIM_SHM_SIZE=16gb
NAVSIM_NETWORK_MODE=none
NAVSIM_TORCH_CACHE=/data/cache/navsim/torch
NAVSIM_HF_CACHE=/data/cache/navsim/huggingface

# Runtime modes
SIM_NETWORK_MODE=host
DGX_NETWORK_MODE=host
DISPLAY=
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=all

# Persistent paths
DATA_ROOT=./data
ARTIFACT_ROOT=./artifacts
MAPS_DIR=./data/maps
BAGS_DIR=./data/bags
GROUND_TRUTH_DIR=./data/ground_truth
DATASETS_DIR=./data/datasets
MODELS_DIR=./data/models
ENGINES_DIR=./data/engines
LOGS_DIR=./data/logs
REPORTS_DIR=./data/reports
CACHE_DIR=./data/cache

# Data capture
# Leave empty to generate a unique UTC run name when Recorder starts.
BAG_NAME=
BAG_STORAGE=mcap
TOPIC_FILE=/config/record/topics.txt
RECORDER_PROFILE=record
MAX_BAG_SIZE_GB=100
DATASET_SOURCE_ID=awsim

# Acceptance thresholds. Set these before running Harness tests.
TIME_SYNC_MAX_OFFSET_MS=5
MIN_NETWORK_THROUGHPUT_MBPS=500
MAX_NETWORK_JITTER_MS=5
MAX_NETWORK_PACKET_LOSS_PCT=0.1
IPERF_PORT=5201
IPERF_DURATION_SEC=10
MAX_TOPIC_DROP_RATE=0.01
MAX_TIMESTAMP_GAP_MS=100
MAX_E2E_LATENCY_MS=200
SOAK_DURATION_MIN=30
